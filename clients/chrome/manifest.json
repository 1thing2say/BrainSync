{
  "manifest_version": 3,
  "name": "BrainPoint",
  "version": "0.1.0",
  "description": "Click any web page with your eyes and an EEG headset (SSVEP): the BrainSync server finds the buttons and flickers patches over them.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BrainPoint: start or stop in this tab"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Start or stop BrainPoint in this tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["esc.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["flicker.js", "brainsync-client.js", "hints.js", "clicker.js", "point_overlay.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}
