#!/bin/sh
# curtin shim for tests: implements only `curtin in-target [--target=DIR] -- CMD...`
# (DIR defaults to $TARGET_MOUNT_POINT). Like real curtin it bind-mounts /dev,
# /proc and /sys into DIR, here in a private mount namespace (unshare -m, needs
# CAP_SYS_ADMIN) so the mounts vanish with the command, then chroots into DIR.
set -eu
[ "${1:-}" = in-target ] || { echo "curtin shim: only 'in-target' is supported" >&2; exit 2; }
shift
target="${TARGET_MOUNT_POINT:-}"
case "${1:-}" in
    --target=*) target="${1#--target=}"; shift ;;
esac
[ "${1:-}" = -- ] && shift
[ -n "$target" ] || { echo "curtin shim: no target" >&2; exit 2; }
exec unshare -m sh -c '
    t="$1"; shift
    for m in dev proc sys; do mkdir -p "$t/$m"; mount --bind "/$m" "$t/$m"; done
    exec chroot "$t" "$@"' sh "$target" "$@"
