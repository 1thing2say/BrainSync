# brainsyncos-ch341-tegra: the CH340 USB-serial driver (ch341.ko) for NVIDIA's
# L4T kernel, which lacks it (CONFIG_USB_SERIAL_CH341 is not set). V1 Cerelog
# X8 boards use a CH340. Read by scripts/build-packages.sh (plain KEY=value only).
PKG_NAME=brainsyncos-ch341-tegra
# Jetson only: the VM's Ubuntu kernel has ch341 in linux-modules-extra.
PKG_EDITIONS=jetson
# The module directory of nvidia-l4t-kernel TEGRA_KERNEL (config/base-iso.env);
# build.sh checks it against the headers.
KERNEL_RELEASE=6.8.12-1021-tegra
