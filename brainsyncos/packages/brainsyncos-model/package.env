# brainsyncos-model: the default model of the local LLM (config/model.env),
# as brainsyncos-model-MODEL_ID. Read by scripts/build-packages.sh (plain
# KEY=value only).
PKG_NAME=brainsyncos-model
# The switch for which ISOs carry the model. jetson (the default): the Orin
# Nano ISO only; the VM ISO gets no model and 86-model.sh skips there. all:
# the VM ISO carries it too (about 1.3 GB more). An edition without it can
# still be given a model later by installing the package.
PKG_EDITIONS=jetson
