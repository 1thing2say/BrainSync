# espeak-ng: Ubuntu's espeak-ng command (universe), unchanged, the offline
# voice of brainsync/voice.py. Read by scripts/build-packages.sh (plain KEY=value only).
PKG_NAME=espeak-ng
# Jetson only: NVIDIA's install puts libespeak-ng1, espeak-ng-data, libpcaudio0
# and libsonic0 on the Jetson from its pool, but not this command. The VM gets
# espeak-ng from Ubuntu's archive (70-brainsync.sh).
PKG_EDITIONS=jetson
# Ubuntu 24.04 (noble) arm64, the version of the pool's libespeak-ng1. The
# sha256 was checked by hand (2026-10-25) against noble's universe
# Packages.xz and its InRelease, signed by the Ubuntu Archive Automatic
# Signing Key (2018). build.sh trusts only this pin.
DEB_VERSION=1.51+dfsg-12build1
DEB_URL=http://ports.ubuntu.com/ubuntu-ports/pool/universe/e/espeak-ng/espeak-ng_1.51+dfsg-12build1_arm64.deb
DEB_SHA256=cc35c142bb68fd3f0027c729ec645e4b8ef3470edae42140acb1f1dbdee8a818
