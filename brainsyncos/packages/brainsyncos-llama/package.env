# brainsyncos-llama: llama.cpp's llama-server as the local LLM for BrainSync
# (brainsyncos-llama, both editions) and its CUDA backend (brainsyncos-llama-cuda,
# Jetson only). Read by scripts/build-packages.sh (plain KEY=value only).
PKG_NAME=brainsyncos-llama
# Both editions; build.sh adds the -cuda package for the jetson edition.
PKG_EDITIONS=all
