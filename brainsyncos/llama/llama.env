# llama.cpp for BrainSyncOS: the pinned source, how it is built, and what the
# build is checked with. Read by scripts/build-llama.sh and llama/*.sh
# (plain KEY=value only). The packages are packages/brainsyncos-llama/.

# The release, pinned by tarball sha256 and size; the commit is checked
# against the tarball's own header (GitHub's archives carry it).
LLAMA_VERSION=0.7.0
LLAMA_COMMIT=620d2225cc436ab0b001e3200e590e3b286ef9ab
LLAMA_URL=https://github.com/ggml-org/llama.cpp/archive/refs/tags/v0.7.0.tar.gz
LLAMA_TARBALL=llama.cpp-v0.7.0.tar.gz
LLAMA_SHA256=55d67acf3ad2ad747a9bbeb75f9f0e173dbcc0d1753a471038a90c819421c5e1
LLAMA_SIZE=38183379

# Where it is installed on the device. /opt, not /usr/lib: the sonames
# (libllama.so.0, libggml-base.so.0) would clash with Ubuntu's ggml packages.
LLAMA_PREFIX=/opt/brainsyncos/llama
# What --version reports (a tarball has no git): the release's build number
# (tag b11669) and the short commit.
LLAMA_BUILD_NUMBER=11669

# CMake flags of the CPU build (both editions), comma-separated. Offline and
# reproducible: no web UI download, no tests or examples. LLAMA_OPENSSL=OFF:
# the device never downloads models (the service runs with --offline), so no
# HTTPS client and no libssl. LLAMA_SUBPROCESS=OFF: no router mode, built-in
# tools or MCP over stdio, which the service must never use anyway.
# GGML_OPENMP=OFF: ggml's own thread pool instead of OpenMP, because libgomp1
# is in neither target's base layer and the install steps are offline.
CMAKE_FLAGS=-DCMAKE_BUILD_TYPE=Release,-DLLAMA_BUILD_IS_DEV=OFF,-DBUILD_SHARED_LIBS=ON,-DGGML_NATIVE=OFF,-DGGML_BACKEND_DL=ON,-DGGML_CPU_ALL_VARIANTS=ON,-DLLAMA_BUILD_TESTS=OFF,-DLLAMA_BUILD_EXAMPLES=OFF,-DLLAMA_USE_PREBUILT_UI=OFF,-DLLAMA_BUILD_UI=OFF,-DLLAMA_OPENSSL=OFF,-DLLAMA_SUBPROCESS=OFF,-DGGML_OPENMP=OFF
# The CPU backends GGML_CPU_ALL_VARIANTS builds for arm64 (lib/ggml/libggml-cpu-NAME.so).
CPU_VARIANTS=armv8.0_1,armv8.2_1,armv8.2_2,armv8.2_3,armv8.6_1,armv8.6_2,armv9.2_1,armv9.2_2

# The CUDA backend (Jetson edition): a second configure with these flags on
# top, of which only CUDA_TARGET is built. Orin is sm_87, which CUDA 13's
# default list lacks. NO_VMM: no libcuda link, and the fix for the Orin's
# out-of-memory errors (llama.cpp #29142). No NCCL on a single GPU.
CUDA_CMAKE_FLAGS=-DGGML_CUDA=ON,-DCMAKE_CUDA_ARCHITECTURES=87-real,-DGGML_CUDA_NO_VMM=ON,-DGGML_CUDA_NCCL=OFF
CUDA_TARGET=ggml-cuda
CUDA_NVCC_VERSION=13.2.86
# The runtime it is linked against and depends on (NAME=VERSION, comma-separated):
# NVIDIA's Jetson packages for JetPack 7.2.1 (repo.download.nvidia.com/jetson/common r39.2).
CUDA_RUNTIME=cuda-cudart-13-2=13.2.86-1,libcublas-13-2=13.4.1.3-1

# Test inputs, never shipped. A tiny chat model to generate a few tokens on
# CPU (SmolLM2-135M-Instruct, Apache-2.0), pinned by Hugging Face revision.
TEST_MODEL_URL=https://huggingface.co/bartowski/SmolLM2-135M-Instruct-GGUF/resolve/09816acd5d99df7be770d85ea30822623dab342c/SmolLM2-135M-Instruct-Q4_0.gguf
TEST_MODEL_FILE=SmolLM2-135M-Instruct-Q4_0.gguf
TEST_MODEL_SHA256=bcc3af2849ad6095af57e9b5cd43775256efdc66e306acb529172f92d0c04b03
TEST_MODEL_SIZE=91893088
# NVIDIA's real Jetson runtime debs (CUDA_RUNTIME), to resolve and load the
# CUDA backend against; sha256 from the r39.2 Packages index, whose InRelease
# verified against NVIDIA's jetson-ota-public.asc on 2026-10-25.
TEST_CUDART_URL=https://repo.download.nvidia.com/jetson/common/pool/main/c/cuda-cudart/cuda-cudart-13-2_13.2.86-1_arm64.deb
TEST_CUDART_SHA256=550a1c3c915637b5c0d6538b9eba87471742c4be854438ab8a050caabdea8001
TEST_CUBLAS_URL=https://repo.download.nvidia.com/jetson/common/pool/main/libc/libcublas/libcublas-13-2_13.4.1.3-1_arm64.deb
TEST_CUBLAS_SHA256=f6b8cc5b1aac7815ebcd98852d2368559ff3811be499870f4490b3b0e6727983
