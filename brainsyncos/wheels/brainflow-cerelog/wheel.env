# brainflow-cerelog: the Cerelog X8 fork of BrainFlow as a Python wheel for
# the BrainSync venv (/opt/brainsyncos/venv, package brainsync-runtime).
# Read by scripts/build-wheels.sh and ./build.sh (plain KEY=value only).
WHEEL_NAME=brainflow-cerelog

# The fork, pinned by commit; the tree hash is checked after the fetch.
SOURCE_URL=https://github.com/shakimiansky/Shared_brainflow-cerelog
SOURCE_COMMIT=932b3944bfe6c0f4e29a46b4a34afdeba39edd85
SOURCE_TREE=f31dd196ff4fdb5e1706b976ff66ee2637c9a891

# patches/, applied in name order with patch -p1, each pinned by sha256
# (NAME:SHA256, comma-separated). 0001 is the uncommitted change from the
# Mac: raw mode and a 1 s read timeout in connect_v1.
PATCHES=0001-cerelog-connect_v1-raw-timeout.patch:eace7b03a40df30df1fe95a53b5dbaffaac72caa1de419077a024958df4ebc1e

# CMake, called directly: tools/build.py always turns the Synchroni SDK on.
# BRAINFLOW_VERSION is what BoardShim.get_version() reports; the fork has no
# release version of its own, and 5.0.0 is the label the Phase 3 research used.
BRAINFLOW_VERSION=5.0.0
CMAKE_FLAGS=-DCMAKE_BUILD_TYPE=Release,-DBRAINFLOW_VERSION=5.0.0,-DBUILD_SYNCHRONI_SDK=OFF,-DBUILD_BLE=OFF,-DBUILD_BLUETOOTH=OFF,-DBUILD_ONNX=OFF,-DBUILD_TESTS=OFF
CMAKE_TARGETS=BoardController,DataHandler,MLModule

# The wheel: distribution brainflow (the import name, and what pip replaces
# if upstream brainflow is installed: upstream uses board ID 65 for
# IRONBCI_32, so the two must never coexist). The local version names the
# fork commit and our build revision; bump the .N when the patches or flags change.
WHEEL_DIST=brainflow
WHEEL_VERSION=5.0.0+cerelog932b394.1
WHEEL_TAG=py3-none-linux_aarch64
# Its Requires-Dist lines are in requires.txt (this file cannot hold "<").
