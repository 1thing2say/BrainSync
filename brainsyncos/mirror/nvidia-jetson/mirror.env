# nvidia-jetson: NVIDIA's CUDA 13.2 runtime (cudart and cuBLAS) from the
# Jetson apt repository, mirrored unchanged into the Jetson edition's
# repository. Read by scripts/fetch-mirror.sh, scripts/build-repo.sh and
# scripts/mirror.py (plain KEY=value only).
MIRROR_NAME=nvidia-jetson
# Editions whose repository carries these .debs: all, or a comma-separated
# list of jetson and vm. The VM has no NVIDIA GPU.
MIRROR_EDITIONS=jetson

# The repository the stock JetPack 7.2.1 install configures
# (nvidia-l4t-apt-source in the base ISO's pool): common, suite r39.2.
MIRROR_URL=https://repo.download.nvidia.com/jetson/common
MIRROR_SUITE=r39.2
MIRROR_COMPONENT=main
MIRROR_ARCH=arm64

# Its signing key: jetson-ota-public.asc here, the file NVIDIA serves at
# https://repo.download.nvidia.com/jetson/jetson-ota-public.asc and ships in
# nvidia-l4t-apt-source. The primary key's fingerprint must be this one.
MIRROR_KEY=jetson-ota-public.asc
MIRROR_KEY_FPR=3C6D1FF3100C8C3ABB0869C0E6543461A9996195

# What llama.cpp's CUDA backend needs at runtime, at the versions
# nvidia-jetpack 7.2.1 pins. debs.lock holds them and their closure
# (the three cuda-toolkit config-common packages).
MIRROR_ROOTS=cuda-cudart-13-2=13.2.86-1,libcublas-13-2=13.4.1.3-1

# Name prefixes no mirrored package may be, provide or depend on: the
# dGPU driver stack. On a Jetson, libcuda.so.1 comes from L4T
# (nvidia-l4t-cuda-nvgpu); libnvidia-compute would replace it.
MIRROR_FORBID=libnvidia-compute,libnvidia-gl,nvidia-driver-,nvidia-kernel-,nvidia-dkms-,cuda-drivers,cuda-compat,libcuda.so,libcuda1,libcuda-
