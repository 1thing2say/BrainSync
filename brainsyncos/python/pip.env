# The pip that downloads and installs the BrainSync runtime's wheels
# (scripts/venv.sh). It runs from its own wheel (python3 pip.whl/pip), so
# neither the builder nor the venv needs pip installed. Fetched once into
# build/pip/ and checked against this sha256 (from PyPI's JSON API).
# Plain KEY=value only.
PIP_VERSION=26.2.2
PIP_WHEEL_URL=https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl
PIP_WHEEL_SHA256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70
