# BrainSyncOS product config: what scripts/build-iso.sh builds on top of the
# vendor ISO pinned in base-iso.env. Same rules as base-iso.env: plain
# KEY=value only (no quotes, no spaces, no expansions); lists are comma-separated.

BRAINSYNCOS_VERSION=0.1.0

# Board this image is built and tested for (jetsoniso_setup.bash board name).
TARGET_BOARD=jetson-orin-nano-devkit

# Autoinstall files inside AUTOINSTALL_LAYER that get the BrainSync install
# hook (paths inside the layer). Orin Nano/NX and AGX Orin use the orin file;
# Thor boards would install stock JetPack.
HOOKED_AUTOINSTALL=ai/jetsoniso_orin-ai.yaml

# Install entry listed first (highlighted) in the boot menu: nvme, microsd or usb.
INSTALL_TARGET_DEFAULT=nvme

# Seconds the boot menu waits before starting the highlighted entry. -1 waits
# for a key press (NVIDIA's default). Any value >= 0 makes booting this USB
# stick erase and reinstall the default disk with nobody at the keyboard.
GRUB_TIMEOUT=-1

# The appliance account created at install time (replaces NVIDIA's OOBE).
# Logins: SSH keys from config/authorized_keys and/or a console password from
# config/brainsync-password.hash (both gitignored; at least one is required).
BRAINSYNC_USER=brainsync

# Hostname: HOSTNAME_PREFIX-<last 6 characters of the board serial number>,
# e.g. brainsync-a1b2c3 (reachable as brainsync-a1b2c3.local via avahi).
HOSTNAME_PREFIX=brainsync

# Largest installer ISO a build may write, in bytes. The ISO builds estimate
# the size before their slow steps and check the finished image; above this
# they stop. An ISO is written raw to the whole stick (scripts/write-usb.sh,
# dd), so a stick takes an image as large as its capacity. "8 GB" means
# 8,000,000,000 bytes, and real sticks are often a little smaller (the
# controller keeps part of the flash), by up to a few percent. 7,800,000,000
# leaves 200 MB (2.5 %) for that. write-usb.sh still compares the ISO with
# the actual stick. For a 16 GB stick use e.g. 15600000000.
ISO_MAX_BYTES=7800000000
