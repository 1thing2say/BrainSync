# BrainSyncOS package repository: how scripts/build-repo.sh lays out and
# signs the apt repository that ships on the ISO (/brainsyncos-repo) and
# that the install.d steps install from. Plain KEY=value only.

# Suite (= codename) and component of the repository: the install steps use
# "deb file:<repo> <suite> <component>".
REPO_SUITE=brainsyncos
REPO_COMPONENT=main

# Origin and Label fields of the signed Release file.
REPO_ORIGIN=BrainSyncOS
REPO_LABEL=BrainSyncOS

# Lifetime of a signing key made by scripts/make-repo-key.sh (gpg expiry:
# Ny years, Nm months, or 0 for none).
REPO_KEY_EXPIRE=3y

# E-mail in the Maintainer field ("BrainSyncOS <EMAIL>") of the packages
# BrainSyncOS builds.
PACKAGE_MAINTAINER_EMAIL=brainsyncos@localhost
