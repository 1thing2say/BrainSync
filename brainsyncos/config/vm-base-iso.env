# BrainSyncOS VM edition: pinned base ISO (stock Ubuntu Server arm64).
# Same rules and key names as base-iso.env (plain KEY=value, no quotes, no
# spaces, no expansions), so lib.sh's ISO helpers work on either edition.
# Loaded by load_vm_config instead of base-iso.env; never both in one process.

# The vendor ISO: downloaded by scripts/fetch-vm-base.sh into build/downloads/
# (gitignored), verified against these pins, never modified.
BASE_ISO_NAME=ubuntu-24.04.5-live-server-arm64.iso
# Point-release directory (stays put when the next 24.04.x ships; the
# releases/24.04/release/ alias then moves on). Holds SHA256SUMS(.gpg) too.
BASE_ISO_URL=https://cdimage.ubuntu.com/releases/24.04.5/release/ubuntu-24.04.5-live-server-arm64.iso
# From Canonical's SHA256SUMS, signed by the Ubuntu CD Image Automatic Signing
# Key (2012), fingerprint 8439 38DF 228D 22F7 B374 2BC0 D94A A3F0 EFE2 1092.
BASE_ISO_SHA256=f12484464c7d4d73e2167e0a7dbda1e669f8fae9bcf778dc0944937034b320cb
BASE_ISO_SIZE=3825512448
# Volume id "Ubuntu-Server 24.04.5 LTS arm64"; config values cannot hold spaces, so _ stands for one.
BASE_ISO_VOLID=Ubuntu-Server_24.04.5_LTS_arm64
# /.disk/info must contain "Ubuntu-Server ${UBUNTU_RELEASE} LTS", "(${BASE_ISO_DISK_INFO_BUILD})" and "${BASE_ISO_ARCH}".
BASE_ISO_DISK_INFO_BUILD=20260908.2
BASE_ISO_ARCH=arm64
# Boot bytes the replay copies straight from the base file: the appended EFI
# System partition (512-byte sectors; MBR partition 2, type 0xef; shim + signed
# GRUB, no grub.cfg) and the 32 KiB system area (MBR only, no GPT).
BASE_ESP_START_SECTOR=7456512
BASE_ESP_SIZE_SECTORS=14592
BASE_ESP_SHA256=5e2c2cd2166d495becd2218362a3ca5d154d48b4340913a27e857ef80a6e09bd
BASE_SYSTEM_AREA_SHA256=1c81cd44b240e846b7225be9ac42cc14298f50d10195e7224625eef851918b96
# ISO9660/Joliet naming rules that reproduce the base's primary (uppercase,
# 31 characters) and Joliet (long names) trees exactly; found by trial with
# compare-iso.sh --edition vm, as for the Jetson ISO.
ISO_COMPLIANCE=iso_9660_level=3:joliet_long_names:allow_dir_id_ext:joliet_long_paths

# Release identity.
UBUNTU_RELEASE=24.04.5
UBUNTU_CODENAME=noble

# Minimum free disk (GiB) before build-vm-iso.sh starts (one ~3.6 GiB output).
MIN_FREE_GB=10
