# BrainSyncOS build resources: what scripts/builder.sh gives every builder
# container. Plain KEY=value only, like the other config files. Each value can
# be overridden for one run from the environment as BSOS_<KEY> (e.g.
# BSOS_BUILD_CPUS=4 scripts/build.sh all).

# CPUs the container may use (docker run --cpus). The default leaves most of
# the Mac free while a build runs; builds get slower, not different.
BUILD_CPUS=2

# Parallel jobs for compilers inside the container (BSOS_JOBS, MAKEFLAGS=-jN,
# CMAKE_BUILD_PARALLEL_LEVEL). Keep it at BUILD_CPUS or below.
BUILD_JOBS=2

# Memory limit of the container (docker run --memory). The /scratch tmpfs
# counts against it, so it must stay well above BUILD_SCRATCH_SIZE.
BUILD_MEMORY=6g

# Size of the /scratch tmpfs (squashfs work, GnuPG homes).
BUILD_SCRATCH_SIZE=3g
