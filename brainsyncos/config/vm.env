# BrainSyncOS VM edition product config: what scripts/build-vm-iso.sh builds
# on top of the Ubuntu ISO pinned in vm-base-iso.env, plus the defaults
# scripts/utm-vm.sh uses for the UTM VM. Same rules as the other configs:
# plain KEY=value only. Version, account and hostname prefix are NOT here:
# they come from brainsyncos.env (BRAINSYNCOS_VERSION, BRAINSYNC_USER,
# HOSTNAME_PREFIX), shared with the Jetson edition.

# Edition name: release file EDITION= and the ISO name brainsyncos-VERSION-EDITION.iso.
EDITION=vm-arm64

# Seconds the boot menu waits before starting the highlighted install entry,
# which erases the VM's disk; -1 waits for a key press. 10: the ISO is meant
# for a fresh VM, utm-vm.sh install runs unattended (also --hide), and the
# installer powers off and is ejected, so it never boots again by itself.
VM_GRUB_TIMEOUT=10

# Desktop installed with the system: minimal (ubuntu-desktop-minimal, GNOME as
# on the Jetson), full (ubuntu-desktop) or none (server only). Downloaded
# during the install (about 1.5 GB, several minutes more).
VM_DESKTOP=minimal

# Kernel the first install entry boots (and installs): ga (6.8) or hwe. The
# other one is in the boot menu's Advanced options.
VM_INSTALL_KERNEL=ga

# Kernel consoles for the installer and the installed system, in order; the
# last one becomes /dev/console. ttyAMA0 = UTM QEMU serial (PL011), hvc0 =
# UTM Apple Virtualization serial (virtio console), tty0 = the display.
# Consoles the VM does not have are ignored.
VM_CONSOLES=ttyAMA0,hvc0,tty0

# scripts/utm-vm.sh defaults (override with its options). The name must start
# with BrainSyncOS: utm-vm.sh never touches any other VM.
VM_NAME=BrainSyncOS
# apple (Apple Virtualization: fast, no USB passthrough on macOS < 27) or
# qemu (QEMU + Hypervisor.framework: USB sharing for the EEG board, guest agent).
VM_BACKEND=apple
VM_MEMORY_MB=4096
VM_CPU_CORES=4
VM_DISK_GB=32
