# BrainSyncOS base image pin: single source of truth for every script.
# Plain KEY=value only (sourced by bash and usable as `docker run --env-file`):
# no quotes, no spaces, no expansions. Lists are comma-separated.

# The vendor ISO. User-supplied, never committed, never modified.
BASE_ISO_NAME=jetsoninstaller-r39.2.1-2026-08-07-18-30-47-arm64.iso
BASE_ISO_SHA256=f31cf35023cd072707dfc46ef23ed71318449516333055fe3bb9455a615395d0
BASE_ISO_SIZE=5035601920
BASE_ISO_VOLID=jetsoninstaller-r39.2.1
# /.disk/info must contain "Ubuntu-Server ${UBUNTU_RELEASE} LTS" and "(${BASE_ISO_DISK_INFO_BUILD})".
BASE_ISO_DISK_INFO_BUILD=20250806.1
# Boot bytes repack-iso.sh replays straight from the base file, hashed when it
# was verified: the appended EFI System partition (512-byte sectors) and the
# 32 KiB system area (MBR + GPT, ISO blocks 0-15).
BASE_ESP_START_SECTOR=8785920
BASE_ESP_SIZE_SECTORS=1048576
BASE_ESP_SHA256=7f7c8a542118d508f55593c98d8bca132426b36edb8db76689d8ce28c8b5793e
BASE_SYSTEM_AREA_SHA256=2918cf44798c9ad97d3ab8fc02be3f6967cca57dbbe2627d53b26c11795293e6
# ISO9660/Joliet naming rules that reproduce the base's primary and Joliet
# trees exactly (found by trial; -boot_image any replay does not restore them).
ISO_COMPLIANCE=iso_9660_level=3:joliet_long_names:lowercase:allow_dir_id_ext:joliet_long_paths

# Release identity.
L4T_RELEASE=39.2.1
JETPACK_RELEASE=7.2.1
UBUNTU_RELEASE=24.04.3
UBUNTU_CODENAME=noble

# Kernel shipped to the installed system (nvidia-l4t-kernel package version)
# and the kernel the live installer itself boots.
TEGRA_KERNEL=6.8.12-tegra-39.2.1-20260806224157
LIVE_KERNEL=6.8.12-1021-tegra

# Casper layer chain the live installer mounts (initrd conf/conf.d/default-layer.conf).
CASPER_LAYERFS_PATH=ubuntu-server-minimal.ubuntu-server.installer.kernel.nvidia.squashfs
# Layer that carries /autoinstall.yaml and /ai/* (NVIDIA overlay, never reaches the target).
AUTOINSTALL_LAYER=ubuntu-server-minimal.ubuntu-server.installer.kernel.nvidia.squashfs
# Layer whose manifest must list nvidia-l4t-kernel ${TEGRA_KERNEL}.
KERNEL_LAYER_MANIFEST=casper/ubuntu-server-minimal.ubuntu-server.installer.kernel.manifest

# Install targets offered by the vendor grub.cfg (force-bootdisk= values; usb has none).
BOOT_TARGETS=nvme0n1,usb,mmcblk0,mmcblkn
# Boards jetsoniso_setup.bash detects (DT model match).
SUPPORTED_BOARDS=jetson-agx-thor,jetson-agx-orin,jetson-orin-nx-nano

# Builder image.
BUILDER_IMAGE_NAME=brainsyncos-builder
BUILDER_PLATFORM=linux/arm64

# Minimum free disk (GiB) before extract/repack/test will start.
MIN_FREE_GB=20
