# BrainSyncOS default model: the GGUF file the local LLM (llama-server, Phase
# 3d) runs, shipped by packages/brainsyncos-model as
# brainsyncos-model-MODEL_ID. Read by scripts/model.sh. Plain KEY=value only;
# lists are comma-separated. The download is pinned three ways: repository,
# revision (a commit, never a branch) and sha256 with the size. A rebuild
# downloads nothing; every build checks the sha256 again.
#
# Why this file: Qwen publishes no GGUF of Qwen3.5-2B, and ggml-org has only
# the 0.8B and 35B-A3B. unsloth/Qwen3.5-2B-GGUF is converted from the official
# Qwen/Qwen3.5-2B (its base_model), Apache-2.0 like it, and by far the most
# used GGUF of it (about 404,000 downloads in the last month on 2026-10-25,
# against 48,000 for bartowski's and 40,000 for lmstudio-community's). Its
# repository has not changed since 2026-03-02. Q4_K_M is the size the 8 GB
# Orin Nano and an 8 GB USB stick allow (docs/phase3-research/findings.md).
MODEL_ID=qwen3.5-2b-q4km
MODEL_HF_URL=https://huggingface.co
MODEL_HF_REPO=unsloth/Qwen3.5-2B-GGUF
MODEL_HF_REVISION=f6d5376be1edb4d416d56da11e5397a961aca8ae
MODEL_FILE=Qwen3.5-2B-Q4_K_M.gguf
MODEL_SIZE=1280835840
MODEL_SHA256=aaf42c8b7c3cab2bf3d69c355048d4a0ee9973d48f16c731c0520ee914699223
# general.file_type in the GGUF header (15 is llama.cpp's MOSTLY_Q4_K_M),
# checked by the build, and its name for people.
MODEL_FILE_TYPE=15
MODEL_QUANT=Q4_K_M

# The licence text that ships with it: the unsloth repository has no LICENSE
# file, so it comes from the official Qwen/Qwen3.5-2B (Apache-2.0,
# "Copyright 2026 Alibaba Cloud"), pinned the same way.
MODEL_LICENSE=Apache-2.0
MODEL_LICENSE_HF_REPO=Qwen/Qwen3.5-2B
MODEL_LICENSE_HF_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
MODEL_LICENSE_FILE=LICENSE
MODEL_LICENSE_SIZE=11544
MODEL_LICENSE_SHA256=bbedc3fda3305820b977265f01b8619d87570a6739de3a5582c3464840f1e57a

# llama-server options for this model, comma-separated (no spaces in this
# file). They become BSOS_LLAMA_ARGS in /etc/brainsyncos/llama.d/model.conf.
# 4096 tokens of context hold a BCI Voice page (about 1,000) many times over
# and keep the KV cache small on the 8 GB Orin Nano.
MODEL_LLAMA_ARGS=-c,4096
