# BrainSyncOS llama builder: the arm64 toolbox that compiles llama.cpp
# natively on an arm64 host (scripts/builder.sh --llama picks it on Apple
# Silicon and other aarch64 hosts; an x86-64 host gets the amd64 cross-builder,
# Dockerfile.cross-builder, instead). Used only for scripts/build-llama.sh
# compile; everything else, and every check of its output, runs in the arm64
# builder (Dockerfile.builder).
# The same pinned Ubuntu 24.04 base (a manifest list: arm64 here). From noble:
# gcc-14 and g++-14 (gcc-13 fails on llama.cpp's SME variants), cmake, ninja,
# curl (the source download), python3 and the binutils to check the result.
# From NVIDIA's Jetson repository (repo.download.nvidia.com/jetson/common,
# suite r39.2, the one the stock JetPack 7.2.1 install configures), signed by
# the committed mirror/nvidia-jetson/jetson-ota-public.asc (fingerprint
# checked below; it reaches the build as the named build context
# "nvidia-jetson"): nvcc 13.2 for aarch64 with its runtime, headers and
# cuBLAS development files, every package pinned to the version of the Jetson
# runtime the backend must match (cudart 13.2.86, cuBLAS 13.4.1.3). The three
# cuda-toolkit*-config-common packages are 13.2.86-1 in this repository (the
# ubuntu2404 repository's are 13.4.92-1). Build only: nothing from this image
# ships. noble's own packages float like the builder's; dpkg-query writes what
# was installed to /usr/share/brainsyncos/builder-packages.txt.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC

# docker build --build-context nvidia-jetson=mirror/nvidia-jetson (builder.sh does this).
COPY --from=nvidia-jetson jetson-ota-public.asc /tmp/jetson-ota-public.asc

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc-14 g++-14 binutils \
      cmake ninja-build make python3 file ca-certificates curl gnupg \
 && fpr="$(gpg --batch --with-colons --show-keys /tmp/jetson-ota-public.asc | awk -F: '/^fpr:/ {print $10; exit}')" \
 && [ "$fpr" = 3C6D1FF3100C8C3ABB0869C0E6543461A9996195 ] \
 && gpg --batch --dearmor < /tmp/jetson-ota-public.asc > /usr/share/keyrings/nvidia-jetson.gpg \
 && rm /tmp/jetson-ota-public.asc \
 && echo 'deb [arch=arm64 signed-by=/usr/share/keyrings/nvidia-jetson.gpg] https://repo.download.nvidia.com/jetson/common r39.2 main' \
      > /etc/apt/sources.list.d/nvidia-jetson.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      cuda-nvcc-13-2=13.2.86-1 cuda-crt-13-2=13.2.86-1 libnvvm-13-2=13.2.86-1 \
      libnvptxcompiler-13-2=13.2.86-1 cuda-cudart-13-2=13.2.86-1 cuda-cudart-dev-13-2=13.2.86-1 \
      cuda-cccl-13-2=13.2.86-1 cuda-culibos-dev-13-2=13.2.86-1 cuda-driver-dev-13-2=13.2.86-1 \
      cuda-toolkit-13-2-config-common=13.2.86-1 cuda-toolkit-13-config-common=13.2.86-1 \
      cuda-toolkit-config-common=13.2.86-1 \
      libcublas-13-2=13.4.1.3-1 libcublas-dev-13-2=13.4.1.3-1 \
 && rm -rf /var/lib/apt/lists/* \
 && [ "$(uname -m)" = aarch64 ] \
 && /usr/local/cuda-13.2/bin/nvcc --version | grep -q 'V13.2.86$' \
 && [ -e /usr/local/cuda-13.2/include/cuda_runtime.h ] \
 && [ -e /usr/local/cuda-13.2/lib64/libcublas.so ] \
 && [ -e /usr/local/cuda-13.2/lib64/libcudart.so ] \
 && mkdir -p /usr/share/brainsyncos \
 && dpkg-query -W -f '${Package} ${Version}\n' > /usr/share/brainsyncos/builder-packages.txt

WORKDIR /work
