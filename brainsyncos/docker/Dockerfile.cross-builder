# BrainSyncOS cross-builder: an amd64 toolbox that compiles aarch64 code at
# native speed on an x86-64 host (scripts/builder.sh --cross). Used only for
# llama.cpp (scripts/build-llama.sh compile); everything else, and every check
# of its output, runs in the arm64 builder (Dockerfile.builder).
# The same pinned Ubuntu 24.04 base (a manifest list: amd64 here). From noble:
# gcc-14 and g++-14 for aarch64-linux-gnu (gcc-13 fails on llama.cpp's SME
# variants), with libc6-dev and libstdc++ for arm64 as the sysroot, plus
# cmake, ninja, curl (the source download) and the binutils to check the
# result. From NVIDIA's CUDA repositories for ubuntu2404 (signed by the key in
# nvidia-cuda-ubuntu2404.pub, fingerprint checked below): nvcc 13.2 for
# x86_64 and the cross-linux-sbsa target files (cudart, headers, cuBLAS link
# stubs), every package pinned to the version of the Jetson runtime it must
# match (cudart 13.2.86, cuBLAS 13.4.1.3). The target files are NVIDIA's SBSA
# build, the same build the Jetson repository re-hosts. Nothing from this
# image ships. noble's own packages float like the builder's; dpkg-query
# writes what was installed to /usr/share/brainsyncos/builder-packages.txt.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC

COPY nvidia-cuda-ubuntu2404.pub /tmp/nvidia-cuda.pub

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc-14-aarch64-linux-gnu g++-14-aarch64-linux-gnu binutils-aarch64-linux-gnu \
      cmake ninja-build make python3 file ca-certificates curl gnupg \
 && fpr="$(gpg --batch --with-colons --show-keys /tmp/nvidia-cuda.pub | awk -F: '/^fpr:/ {print $10; exit}')" \
 && [ "$fpr" = EB693B3035CD5710E231E123A4B469963BF863CC ] \
 && gpg --batch --dearmor < /tmp/nvidia-cuda.pub > /usr/share/keyrings/nvidia-cuda.gpg \
 && rm /tmp/nvidia-cuda.pub \
 && for r in x86_64 cross-linux-sbsa; do \
      echo "deb [signed-by=/usr/share/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/$r/ /"; \
    done > /etc/apt/sources.list.d/nvidia-cuda.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      cuda-nvcc-13-2=13.2.86-1 cuda-crt-13-2=13.2.86-1 libnvvm-13-2=13.2.86-1 \
      libnvptxcompiler-13-2=13.2.86-1 cuda-cudart-13-2=13.2.86-1 cuda-cudart-dev-13-2=13.2.86-1 \
      cuda-cccl-13-2=13.2.86-1 cuda-culibos-dev-13-2=13.2.86-1 cuda-driver-dev-13-2=13.2.86-1 \
      cuda-toolkit-13-2-config-common=13.2.86-1 cuda-toolkit-13-config-common=13.4.92-1 \
      cuda-toolkit-config-common=13.4.92-1 \
      cuda-nvcc-cross-sbsa-13-2=13.2.86-1 cuda-cudart-cross-sbsa-13-2=13.2.86-1 \
      cuda-crt-cross-sbsa-13-2=13.2.86-1 cuda-cccl-cross-sbsa-13-2=13.2.86-1 \
      cuda-culibos-cross-sbsa-13-2=13.2.86-1 cuda-driver-cross-sbsa-13-2=13.2.86-1 \
      libnvvm-cross-sbsa-13-2=13.2.86-1 libnvptxcompiler-cross-sbsa-13-2=13.2.86-1 \
      libcublas-cross-sbsa-13-2=13.4.1.3-1 \
 && rm -rf /var/lib/apt/lists/* \
 && /usr/local/cuda-13.2/bin/nvcc --version | grep -q 'V13.2.86$' \
 && [ -e /usr/local/cuda-13.2/targets/sbsa-linux/lib/stubs/libcublas.so ] \
 && mkdir -p /usr/share/brainsyncos \
 && dpkg-query -W -f '${Package} ${Version}\n' > /usr/share/brainsyncos/builder-packages.txt

WORKDIR /work
