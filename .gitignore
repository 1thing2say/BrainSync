# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments and secrets (ANTHROPIC_API_KEY lives in the environment, never in the repo)
.venv/
venv/
.env
.env.*

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Session logs (app/log.py)
logs/

# A real user's profile (personal data): stays on this computer, never committed
profiles/

# Cartesia clips cached on disk (app/tts.py)
cache/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local ssvep reference copy, local tool state and recordings
/ssvep/
.dmux/
data/*
!data/README.md

# Claude Code: local instructions and settings (never committed)
CLAUDE.md
CLAUDE.local.md
.claude/

# BrainSyncOS build cache/output and any ISO images (the base ISO is user-supplied)
brainsyncos/build/
brainsyncos/**/*.iso

# BrainSyncOS login credentials baked into a build (user-specific, never commit)
brainsyncos/config/authorized_keys
brainsyncos/config/brainsync-password.hash

# dmux hook templates (tool config, not project code)
.dmux-hooks/

# TRIBE v2 heatmap: its own venv, model cache and rendered clips
.venv-tribe/
.tribe-cache/
extension/heatmap/clips/
