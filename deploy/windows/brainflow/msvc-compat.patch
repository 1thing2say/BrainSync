-#include <atlstr.h>
 #include <string.h>
 
-// no unicode!
+// no unicode! (plain Win32, no ATL: newer MSVC's ATL refuses MBCS builds)
 inline bool get_dll_path (char *res)
 {
-    CString this_path = "";
-    WCHAR path[MAX_PATH];
+    char path[MAX_PATH];
     HMODULE hm;
-    if (GetModuleHandleExW (
+    if (!GetModuleHandleExA (
             GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
-            (LPWSTR)&get_dll_path, &hm))
+            (LPCSTR)&get_dll_path, &hm))
     {
-        GetModuleFileNameW (hm, path, sizeof (path));
-        PathRemoveFileSpecW (path);
-        this_path = CStringW (path);
-        if (!this_path.IsEmpty () && this_path.GetAt (this_path.GetLength () - 1) != '\\')
-            this_path += "\\";
+        return false;
     }
-    else
+    DWORD len = GetModuleFileNameA (hm, path, MAX_PATH);
+    if (len == 0 || len >= MAX_PATH)
     {
         return false;
     }
-    char *buf = NULL;
-    buf = this_path.GetBuffer (this_path.GetLength ());
-    this_path.ReleaseBuffer ();
-    strcpy (res, buf);
+    char *slash = strrchr (path, '\\');
+    if (slash != NULL)
+    {
+        slash[1] = '\0';
+    }
+    strcpy (res, path);
     return true;
 }
 
