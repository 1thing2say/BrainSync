# systemd unit: the BrainSync server behind a Cloudflare quick tunnel, started at boot. The
# link goes to ~/brainsync-link.txt (mode 0600) and to the serial consoles; see README.md.
#
# A template: install.sh fills in @USER@ (the login user, so the link lands in that home),
# @HOME@ and @BRAINSYNC_DIR@, then installs it as /etc/systemd/system/brainsync-tunnel.service:
#
#   sudo deploy/jetson/install.sh          # everything; or only the tunnel:
#   sudo deploy/jetson/cloudflare/install.sh
#   journalctl -u brainsync-tunnel -f      # "tunnel up: https://<name>.trycloudflare.com ..."
#
# Settings: /etc/brainsync/tunnel.env (see the top of brainsync-tunnel.sh). The API key for point
# mode: ANTHROPIC_API_KEY=... in /etc/brainsync/env (root-only, read before dropping privileges).

[Unit]
Description=BrainSync server behind a Cloudflare quick tunnel (link on serial and in ~/brainsync-link.txt)
Documentation=file:@BRAINSYNC_DIR@/deploy/jetson/cloudflare/README.md
Wants=network-online.target
# An old brainsync-server.service from earlier versions served 127.0.0.1:8765 too: starting
# this one stops it first (install.sh removes it).
Conflicts=brainsync-server.service
After=network-online.target brainsync-server.service
# Never give up: at a venue the Wi-Fi may come up minutes after boot.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
# dialout: the Cerelog's /dev/ttyUSB* or /dev/ttyACM*, and serial ports nobody has opened;
# tty: consoles a getty owns (root:tty, mode 0620), such as /dev/ttyGS0 and /dev/ttyTCU0.
SupplementaryGroups=dialout tty
WorkingDirectory=@BRAINSYNC_DIR@
Environment=BRAINSYNC_DIR=@BRAINSYNC_DIR@
Environment=LINK_FILE=@HOME@/brainsync-link.txt
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/brainsync/env
EnvironmentFile=-/etc/brainsync/tunnel.env
ExecStart=@BRAINSYNC_DIR@/deploy/jetson/cloudflare/brainsync-tunnel.sh
# A child that exits, or no tunnel address in time: start over (with a new address).
Restart=always
RestartSec=10
# Exit 2 is a setting to fix first (a cloudflared config file, a bad SERVER_ARGS).
RestartPreventExitStatus=2
# SIGTERM goes to the supervisor, which stops the server (clients get "phase stop") and
# cloudflared, deletes the link file and exits 0; whatever is left then gets SIGKILL.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The home stays visible: the token (~/.config/brainsync/token) and the link file live there.
ProtectHome=read-only
ReadWritePaths=@HOME@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
